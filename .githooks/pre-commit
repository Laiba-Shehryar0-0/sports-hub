#!/bin/sh
#
# Two independent, independently-scoped checks. Each stays off the critical path
# for commits that cannot affect it.
#
# Installed via core.hooksPath (see the `prepare` script in package.json), so it
# lives in the repo and survives a clone, unlike .git/hooks.

set -e

changed=$(git diff --cached --name-only --diff-filter=ACM)

# ── 1. SQL under src/db/ ─────────────────────────────────────────────────────
#
# This exists because stray text (" 1  Q") was once typed into the head of
# src/db/seeds/002_pricing.sql and committed. 001_kits.sql still applied, so the
# catalog looked fine, but kit_prices and delivery_methods were never populated.
# Nobody noticed for days: an already-seeded local database keeps working, and
# only a fresh setup would have hit it. `npm run check:seeds` catches it — but a
# check nobody remembers to run is not a control, so it runs here automatically.

staged_sql=$(echo "$changed" | grep -E '^src/db/.*\.sql$' || true)

if [ -n "$staged_sql" ]; then
  echo "pre-commit: SQL staged under src/db/ — validating"

  # check-seeds.mjs reads the working tree, not the index. For the failure mode
  # this guards against (stray keystrokes, then commit) those are identical, but
  # warn when they are not so the result isn't trusted more than it deserves.
  for file in $staged_sql; do
    if ! git diff --quiet -- "$file" 2>/dev/null; then
      echo "  warning: $file has unstaged changes — validating the working tree, not the staged blob"
    fi
  done

  if ! npm run --silent check:seeds; then
    echo ""
    echo "pre-commit: BLOCKED — SQL under src/db/ failed validation (see above)."
    echo "Fix the file, or bypass with 'git commit --no-verify' if you are certain."
    exit 1
  fi
fi

# ── 2. Cross-repo reference drift ────────────────────────────────────────────
#
# THIS HOOK IS NOT THE PRIMARY GUARD FOR THIS — READ BEFORE RELYING ON IT.
#
# sync-reference.mjs guards two directions:
#
#   SOURCES   7 files that live in ../kit-frontend, mirrored INTO
#             docs/frontend-reference/. They can NEVER appear in a commit to
#             this repo, so nothing staged here can trigger a check on them.
#   GENERATED src/modules/orders/orders.constants.js -> the frontend's
#             countries.js. That source DOES live here.
#
# So this block catches the GENERATED direction at source: change the country
# list without regenerating, and the commit is blocked. It cannot catch the
# SOURCES direction at all — Customize.jsx drifted through two whole phases and
# no backend commit could have noticed. kit-frontend/.githooks/pre-commit is the
# real control for that half; this is the other half of the same pair.

staged_ref=$(echo "$changed" | grep -E '^(src/modules/orders/orders\.constants\.js|docs/frontend-reference/)' || true)

if [ -n "$staged_ref" ]; then
  echo "pre-commit: reference source staged — checking mirrors"

  if ! npm run --silent sync:reference -- --check; then
    echo ""
    echo "pre-commit: BLOCKED — generated/mirrored files are out of date (see above)."
    echo "Run 'npm run sync:reference' and stage the result."
    exit 1
  fi
fi

exit 0
