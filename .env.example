NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=kitworld_app
DB_PASSWORD=
DB_NAME=kitworld
DB_NAME_TEST=kitworld_test
DB_CONNECTION_LIMIT=10

# Used only by `npm run migrate` — needs CREATE/ALTER/DROP rights that
# DB_USER (the app's runtime account) must not have. Leave DB_USER as a
# DML-only account; point these at a privileged user instead.
DB_MIGRATE_USER=
DB_MIGRATE_PASSWORD=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

CORS_ORIGIN=http://localhost:5173

# Filesystem roots. Both optional — leave blank unless you are moving storage.
# MUST be absolute if set: a relative path resolves against the process's working directory, so
# the same value would mean different directories depending on how the server was launched, and
# every already-stored logo URL would 404 against the moved mount.
#
# STATIC_ROOT defaults to <repo>/public/static and holds the committed kit images.
# LOGO_DIR defaults to <STATIC_ROOT>/logos and holds runtime uploads — point it at a mounted
# volume in production, so a redeploy that replaces the code directory does not delete user
# uploads. Under NODE_ENV=test it defaults to an OS temp directory instead, and the assets
# service refuses to start if it is anywhere else.
STATIC_ROOT=
LOGO_DIR=

LOG_LEVEL=info

# Verification email delivery. Required when NODE_ENV=production — the server refuses to boot
# without SMTP_HOST there, because signups would otherwise silently never receive a code.
# In development, leaving SMTP_HOST blank suppresses sending and logs the code to the console
# (development ONLY — see docs/known-gaps.md). Mailtrap is the recommended dev inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Kit World Sports <no-reply@kitworldsports.local>
