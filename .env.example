NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=kitworld_app
DB_PASSWORD=
DB_NAME=kitworld
DB_NAME_TEST=kitworld_test
DB_CONNECTION_LIMIT=10

# Used only by `npm run migrate` — needs CREATE/ALTER/DROP rights that
# DB_USER (the app's runtime account) must not have. Leave DB_USER as a
# DML-only account; point these at a privileged user instead.
DB_MIGRATE_USER=
DB_MIGRATE_PASSWORD=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info
